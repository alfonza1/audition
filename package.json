{
  "name": "@alfonza1/audition",
  "version": "0.1.0",
  "private": true,
  "description": "Audition competing app implementations with synchronized semantic actions.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e.mjs",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8"
  }
}
